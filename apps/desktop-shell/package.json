{
  "name": "@zupulse/desktop-shell",
  "private": true,
  "version": "0.1.0",
  "productName": "Zupulse",
  "description": "A local-first workspace for viewing and practicing sheet music.",
  "author": "Zupulse Contributors",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "rspack build --watch --mode development",
    "build": "rspack build",
    "start": "electron .",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:telemetry:e2e": "node ./e2e/telemetry-runner.mjs",
    "package": "pnpm build && electron-forge package && node ./scripts/verify-package.mjs",
    "verify:pdf-omr-runtime": "rspack build --env pdfOmrRuntimeSmoke=1 && electron-forge package && node ./scripts/verify-package.mjs --allow-pdf-omr-smoke && node ./scripts/verify-pdf-omr-runtime.mjs",
    "make": "pnpm build && electron-forge make && node ./scripts/verify-package.mjs",
    "make:mac": "pnpm build && electron-forge make --platform=darwin --arch=arm64 && node ./scripts/verify-package.mjs && node ./scripts/create-dmg.mjs",
    "make:win": "pnpm build && electron-forge make --platform=win32 --arch=x64 && node ./scripts/verify-package.mjs"
  },
  "dependencies": {
    "@zupulse/app-i18n": "workspace:*",
    "@zupulse/pdf-omr-cli": "workspace:*",
    "@zupulse/web-core": "workspace:*",
    "@zupulse/web-viewer": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.61.1",
    "electron": "43.1.0"
  }
}
