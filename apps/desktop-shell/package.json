{
  "name": "@zupulse/desktop-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "rspack build --watch --mode development",
    "build": "rspack build",
    "start": "electron .",
    "test:e2e": "playwright test -c playwright.config.ts",
    "package": "pnpm build && electron-forge package && node ./scripts/verify-package.mjs",
    "make": "pnpm build && electron-forge make"
  },
  "dependencies": {
    "@zupulse/web-core": "workspace:*",
    "@zupulse/web-viewer": "workspace:*"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.61.1",
    "electron": "43.1.0"
  }
}
