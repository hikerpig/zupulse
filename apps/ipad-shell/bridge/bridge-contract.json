{
  "schemaVersion": 1,
  "bridgeVersion": "3.0.0",
  "requestTypes": ["app.handshake", "app.lifecycleAck", "diagnostics.write", "file.select"],
  "eventTypes": ["app.command", "app.lifecycle"],
  "envelope": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "bridgeVersion": { "type": "string", "const": "3.0.0" },
      "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
      "type": {
        "type": "string",
        "enum": [
          "app.handshake",
          "app.lifecycleAck",
          "diagnostics.write",
          "file.select",
          "app.command",
          "app.lifecycle"
        ]
      },
      "payload": {}
    },
    "required": ["bridgeVersion", "correlationId", "type", "payload"],
    "additionalProperties": false
  },
  "requests": {
    "app.handshake": {
      "type": "object",
      "properties": {
        "bridgeVersion": { "type": "string", "const": "3.0.0" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "const": "app.handshake" },
        "payload": {
          "type": "object",
          "properties": {
            "appVersion": { "type": "string" },
            "rendererBuildHash": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "required": ["appVersion", "rendererBuildHash"],
          "additionalProperties": false
        }
      },
      "required": ["bridgeVersion", "correlationId", "type", "payload"],
      "additionalProperties": false
    },
    "app.lifecycleAck": {
      "type": "object",
      "properties": {
        "bridgeVersion": { "type": "string", "const": "3.0.0" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "const": "app.lifecycleAck" },
        "payload": {
          "type": "object",
          "properties": { "state": { "type": "string", "enum": ["suspend", "prepare-close"] } },
          "required": ["state"],
          "additionalProperties": false
        }
      },
      "required": ["bridgeVersion", "correlationId", "type", "payload"],
      "additionalProperties": false
    },
    "diagnostics.write": {
      "type": "object",
      "properties": {
        "bridgeVersion": { "type": "string", "const": "3.0.0" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "const": "diagnostics.write" },
        "payload": {
          "type": "object",
          "properties": {
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
            "operation": {
              "type": "string",
              "enum": [
                "app.runtime",
                "bridge.dispatch",
                "library.refresh",
                "library.import.select",
                "library.open",
                "playback-resume.read",
                "renderer.load",
                "renderer.preload",
                "sidecar.read",
                "studio.open",
                "studio.preview",
                "viewer.operation"
              ]
            },
            "errorCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
            "durationMs": { "type": "number", "minimum": 0 },
            "contentHashPrefix": { "type": "string", "pattern": "^[a-f0-9]{8,16}$" }
          },
          "required": ["code"],
          "additionalProperties": false
        }
      },
      "required": ["bridgeVersion", "correlationId", "type", "payload"],
      "additionalProperties": false
    },
    "file.select": {
      "type": "object",
      "properties": {
        "bridgeVersion": { "type": "string", "const": "3.0.0" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "const": "file.select" },
        "payload": {
          "type": "object",
          "properties": { "multiple": { "type": "boolean" } },
          "required": ["multiple"],
          "additionalProperties": false
        }
      },
      "required": ["bridgeVersion", "correlationId", "type", "payload"],
      "additionalProperties": false
    }
  },
  "responses": {
    "app.handshake": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "appVersion": { "type": "string" },
        "bridgeVersion": { "type": "string", "const": "3.0.0" },
        "rendererBuildHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "capabilities": {
          "type": "object",
          "properties": {
            "pdfOmrWorkbench": { "type": "boolean" },
            "recognitionProviderSettings": { "type": "boolean" },
            "pdfOmrEngines": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "version": { "type": "string", "minLength": 1 },
                  "available": { "type": "boolean" },
                  "inputKinds": {
                    "minItems": 1,
                    "maxItems": 2,
                    "type": "array",
                    "items": { "type": "string", "enum": ["pdf", "image"] }
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "missing-transcoda-configuration",
                      "missing-legato-configuration",
                      "missing-rokot-configuration",
                      "engine-executable-unavailable",
                      "engine-inspection-failed",
                      "checkpoint-unreadable",
                      "repository-revision-mismatch",
                      "checkpoint-hash-mismatch",
                      "python-version-mismatch",
                      "model-unreadable",
                      "base-model-unreadable",
                      "base-model-config-empty",
                      "mmproj-unreadable",
                      "model-hash-mismatch",
                      "mmproj-hash-mismatch",
                      "llama-build-mismatch",
                      "abc-converter-unavailable",
                      "invalid-version-output"
                    ]
                  }
                },
                "required": ["id", "version", "available", "inputKinds"],
                "additionalProperties": false
              }
            },
            "fileAccess": {
              "type": "object",
              "properties": {
                "openExternalFile": { "type": "boolean" },
                "persistentFileReferences": { "type": "boolean" },
                "localLibraryImport": { "type": "boolean" },
                "droppedFileImport": { "type": "boolean" }
              },
              "required": ["openExternalFile", "persistentFileReferences", "localLibraryImport"],
              "additionalProperties": false
            },
            "harmonyAnalysis": { "type": "boolean" },
            "storage": {
              "type": "object",
              "properties": { "sqliteIndex": { "type": "boolean" }, "sidecarPayload": { "type": "boolean" } },
              "required": ["sqliteIndex", "sidecarPayload"],
              "additionalProperties": false
            },
            "sync": {
              "type": "object",
              "properties": {
                "available": { "type": "boolean" },
                "provider": { "type": "string", "enum": ["none", "custom"] }
              },
              "required": ["available", "provider"],
              "additionalProperties": false
            },
            "audio": {
              "type": "object",
              "properties": { "webAudio": { "type": "boolean" }, "nativeBridge": { "type": "boolean" } },
              "required": ["webAudio", "nativeBridge"],
              "additionalProperties": false
            },
            "localization": {
              "type": "object",
              "properties": { "changeLocale": { "type": "boolean" } },
              "required": ["changeLocale"],
              "additionalProperties": false
            },
            "externalNavigation": {
              "type": "object",
              "properties": { "openUrl": { "type": "boolean" } },
              "required": ["openUrl"],
              "additionalProperties": false
            },
            "telemetry": {
              "type": "object",
              "properties": { "available": { "type": "boolean" } },
              "required": ["available"],
              "additionalProperties": false
            }
          },
          "required": ["fileAccess", "storage", "sync", "audio", "localization", "externalNavigation"],
          "additionalProperties": false
        },
        "locale": {
          "type": "object",
          "properties": {
            "preference": { "type": "string", "enum": ["system", "zh-CN", "en-US"] },
            "effectiveLocale": { "type": "string", "enum": ["zh-CN", "en-US"] }
          },
          "required": ["preference", "effectiveLocale"],
          "additionalProperties": false
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "schemaVersion": { "type": "number", "const": 1 },
            "enabled": { "type": "boolean" },
            "noticeAcknowledged": { "type": "boolean" },
            "installationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "applicationSessionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": ["schemaVersion", "enabled", "noticeAcknowledged"],
          "additionalProperties": false
        }
      },
      "required": ["appVersion", "bridgeVersion", "rendererBuildHash", "capabilities", "locale"],
      "additionalProperties": false
    },
    "app.lifecycleAck": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "diagnostics.write": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "file.select": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": { "status": { "type": "string", "const": "cancelled" } },
          "required": ["status"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": { "type": "string", "const": "selected" },
            "files": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fileToken": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "fileName": { "type": "string", "minLength": 1 },
                  "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                },
                "required": ["fileToken", "fileName", "sizeBytes"],
                "additionalProperties": false
              }
            }
          },
          "required": ["status", "files"],
          "additionalProperties": false
        }
      ]
    }
  },
  "events": {
    "app.command": {
      "type": "object",
      "properties": {
        "bridgeVersion": { "type": "string", "const": "3.0.0" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "const": "app.command" },
        "payload": {
          "type": "object",
          "properties": { "command": { "type": "string", "enum": ["open-score", "toggle-playback"] } },
          "required": ["command"],
          "additionalProperties": false
        }
      },
      "required": ["bridgeVersion", "correlationId", "type", "payload"],
      "additionalProperties": false
    },
    "app.lifecycle": {
      "type": "object",
      "properties": {
        "bridgeVersion": { "type": "string", "const": "3.0.0" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "const": "app.lifecycle" },
        "payload": {
          "type": "object",
          "properties": { "state": { "type": "string", "enum": ["suspend", "prepare-close"] } },
          "required": ["state"],
          "additionalProperties": false
        }
      },
      "required": ["bridgeVersion", "correlationId", "type", "payload"],
      "additionalProperties": false
    }
  },
  "capabilities": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pdfOmrWorkbench": { "type": "boolean" },
      "recognitionProviderSettings": { "type": "boolean" },
      "pdfOmrEngines": {
        "maxItems": 16,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1 },
            "available": { "type": "boolean" },
            "inputKinds": {
              "minItems": 1,
              "maxItems": 2,
              "type": "array",
              "items": { "type": "string", "enum": ["pdf", "image"] }
            },
            "reason": {
              "type": "string",
              "enum": [
                "missing-transcoda-configuration",
                "missing-legato-configuration",
                "missing-rokot-configuration",
                "engine-executable-unavailable",
                "engine-inspection-failed",
                "checkpoint-unreadable",
                "repository-revision-mismatch",
                "checkpoint-hash-mismatch",
                "python-version-mismatch",
                "model-unreadable",
                "base-model-unreadable",
                "base-model-config-empty",
                "mmproj-unreadable",
                "model-hash-mismatch",
                "mmproj-hash-mismatch",
                "llama-build-mismatch",
                "abc-converter-unavailable",
                "invalid-version-output"
              ]
            }
          },
          "required": ["id", "version", "available", "inputKinds"],
          "additionalProperties": false
        }
      },
      "fileAccess": {
        "type": "object",
        "properties": {
          "openExternalFile": { "type": "boolean" },
          "persistentFileReferences": { "type": "boolean" },
          "localLibraryImport": { "type": "boolean" },
          "droppedFileImport": { "type": "boolean" }
        },
        "required": ["openExternalFile", "persistentFileReferences", "localLibraryImport"],
        "additionalProperties": false
      },
      "harmonyAnalysis": { "type": "boolean" },
      "storage": {
        "type": "object",
        "properties": { "sqliteIndex": { "type": "boolean" }, "sidecarPayload": { "type": "boolean" } },
        "required": ["sqliteIndex", "sidecarPayload"],
        "additionalProperties": false
      },
      "sync": {
        "type": "object",
        "properties": {
          "available": { "type": "boolean" },
          "provider": { "type": "string", "enum": ["none", "custom"] }
        },
        "required": ["available", "provider"],
        "additionalProperties": false
      },
      "audio": {
        "type": "object",
        "properties": { "webAudio": { "type": "boolean" }, "nativeBridge": { "type": "boolean" } },
        "required": ["webAudio", "nativeBridge"],
        "additionalProperties": false
      },
      "localization": {
        "type": "object",
        "properties": { "changeLocale": { "type": "boolean" } },
        "required": ["changeLocale"],
        "additionalProperties": false
      },
      "externalNavigation": {
        "type": "object",
        "properties": { "openUrl": { "type": "boolean" } },
        "required": ["openUrl"],
        "additionalProperties": false
      },
      "telemetry": {
        "type": "object",
        "properties": { "available": { "type": "boolean" } },
        "required": ["available"],
        "additionalProperties": false
      }
    },
    "required": ["fileAccess", "storage", "sync", "audio", "localization", "externalNavigation"],
    "additionalProperties": false
  },
  "error": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "code": { "type": "string", "minLength": 1 },
      "message": { "type": "string" },
      "recoverable": { "type": "boolean" },
      "details": {}
    },
    "required": ["code", "message", "recoverable"],
    "additionalProperties": false
  }
}
