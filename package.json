{
  "name": "zupulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.3.0",
  "scripts": {
    "check:context": "node scripts/repository-checks.mjs context",
    "check:arch": "node scripts/repository-checks.mjs arch",
    "check:design": "node scripts/repository-checks.mjs design",
    "check:docs": "node scripts/repository-checks.mjs docs",
    "docs:impact": "node scripts/documentation-impact.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "prepare": "[ -f .git ] || simple-git-hooks",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "typecheck": "tsc -b",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify:fast": "pnpm check:context && pnpm check:arch && pnpm check:design && pnpm check:docs && pnpm check:i18n && pnpm format:check && pnpm check",
    "verify": "pnpm verify:fast && pnpm demo:build && pnpm desktop:build",
    "verify:e2e": "pnpm demo:test:e2e && pnpm desktop:test:e2e",
    "fixtures:gp": "node scripts/generate-gp-fixtures.mjs && node scripts/verify-gp-fixtures.mjs",
    "fixtures:musicxml": "node scripts/generate-musicxml-fixtures.mjs && node scripts/verify-musicxml-fixtures.mjs",
    "samples:verify": "node scripts/verify-sample-scores.mjs",
    "benchmark:musicxml": "node scripts/benchmark-musicxml-import.mjs",
    "benchmark:harmony": "node scripts/benchmark-harmony-analysis.mjs",
    "harmony:cli": "vite-node tools/harmony-cli/src/cli.ts",
    "pdf-omr": "vite-node tools/pdf-omr-cli/src/cli.ts",
    "benchmark:pdf-omr": "vite-node tools/pdf-omr-cli/src/cli.ts benchmark",
    "demo:dev": "pnpm --filter @zupulse/web-demo dev",
    "demo:build": "pnpm --filter @zupulse/web-demo build",
    "demo:test:e2e": "pnpm --filter @zupulse/web-demo test:e2e",
    "demo:test:telemetry:e2e": "pnpm --filter @zupulse/web-demo test:telemetry:e2e",
    "desktop:dev": "pnpm --filter @zupulse/desktop-shell dev",
    "desktop:build": "pnpm --filter @zupulse/desktop-shell build",
    "desktop:start": "pnpm --filter @zupulse/desktop-shell start",
    "desktop:test:e2e": "pnpm --filter @zupulse/desktop-shell test:e2e",
    "desktop:test:telemetry:e2e": "pnpm --filter @zupulse/desktop-shell test:telemetry:e2e",
    "desktop:package": "pnpm --filter @zupulse/desktop-shell package",
    "desktop:verify:pdf-omr-runtime": "pnpm --filter @zupulse/desktop-shell verify:pdf-omr-runtime",
    "desktop:make:mac": "pnpm --filter @zupulse/desktop-shell make:mac",
    "desktop:make:win": "pnpm --filter @zupulse/desktop-shell make:win",
    "ipad:web:dev": "pnpm --filter @zupulse/ipad-shell web:dev",
    "ipad:web:build": "node apps/ipad-shell/scripts/build-web-assets.mjs",
    "ipad:release:verify": "node apps/ipad-shell/scripts/verify-release.mjs",
    "ipad:build": "node apps/ipad-shell/scripts/run-xcode-build.mjs",
    "ipad:test": "node apps/ipad-shell/scripts/run-xcode-tests.mjs",
    "ipad:verify": "node apps/ipad-shell/scripts/verify-ipad.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@coderline/alphatab": "1.8.4",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@rspack/cli": "^2.1.8",
    "@rspack/core": "^2.1.8",
    "@rspack/dev-server": "^2.2.0",
    "@tailwindcss/webpack": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^24.1.0",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{css,html,js,json,jsx,md,mjs,ts,tsx,yaml,yml}": "oxfmt --check",
    "*.{js,jsx,mjs,ts,tsx}": "oxlint"
  }
}
