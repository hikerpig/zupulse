{
  "name": "tab-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.3.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check": "pnpm typecheck && pnpm test",
    "fixtures:gp": "node scripts/generate-gp-fixtures.mjs && node scripts/verify-gp-fixtures.mjs",
    "fixtures:musicxml": "node scripts/generate-musicxml-fixtures.mjs && node scripts/verify-musicxml-fixtures.mjs",
    "benchmark:musicxml": "node scripts/benchmark-musicxml-import.mjs",
    "demo:dev": "pnpm --filter @tab-viewer/web-demo dev",
    "demo:build": "pnpm --filter @tab-viewer/web-demo build",
    "desktop:dev": "pnpm --filter @tab-viewer/desktop-shell dev",
    "desktop:build": "pnpm --filter @tab-viewer/desktop-shell build",
    "desktop:start": "pnpm --filter @tab-viewer/desktop-shell start",
    "desktop:test:e2e": "pnpm --filter @tab-viewer/desktop-shell test:e2e",
    "desktop:package": "pnpm --filter @tab-viewer/desktop-shell package"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@coderline/alphatab": "1.8.4",
    "@rspack/cli": "^2.1.3",
    "@rspack/core": "^2.1.3",
    "@rspack/dev-server": "^2.1.0",
    "@types/node": "^20.14.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
